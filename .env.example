# Native app public configuration. These values are embedded in the mobile app
# bundle; do not place credentials, service-role keys, or signing secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Use the exact same legal identity values as web/.env.local in development and
# NEXT_PUBLIC_* values in Vercel production. EAS production builds fail if any
# of the values below are absent.
EXPO_PUBLIC_SITE_URL=https://www.example.com
EXPO_PUBLIC_LEGAL_ENTITY_NAME=Your Legal Entity, Inc.
EXPO_PUBLIC_LEGAL_ADDRESS=123 Example Street, Example City, NY 10001, United States
EXPO_PUBLIC_PRIVACY_EMAIL=privacy@example.com
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
EXPO_PUBLIC_SAFETY_EMAIL=safety@example.com
EXPO_PUBLIC_LEGAL_EFFECTIVE_DATE=July 31, 2026
EXPO_PUBLIC_TERMS_VERSION=2026-07-31
