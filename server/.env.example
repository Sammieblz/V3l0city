# Export these variables in your shell; the server does not auto-load .env files.
V3L0CITY_ENV=development
HOST=127.0.0.1
PORT=8787
V3L0CITY_SERVER_DB=server/data/v3l0city.sqlite
V3L0CITY_PUBLIC_WS_URL=ws://127.0.0.1:8787
SHUTDOWN_TIMEOUT_MS=10000
# Explicit opt-in; /internal/metrics is absent by default. Use a dedicated random
# 32–256 character ASCII URL-safe token from operator secret tooling.
V3L0CITY_METRICS_ENABLED=false
# V3L0CITY_METRICS_TOKEN=replace-through-secret-tooling
# PostgreSQL migration CLI only; use a separate migrator credential, never an app credential.
# DATABASE_URL=postgresql://migrator:replace-me@127.0.0.1:5432/v3l0city
